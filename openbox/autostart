# Transparency manager
picom --config ~/.config/picom.conf &

# Panel
tint2 -c ~/.config/tint2/minimal.tint2rc &

# Network Manager applet
nm-applet &

# Bluetooth manager
blueman-applet &

# Background manager
#feh --no-fehbg --bg-scale /home/ricardo/Pictures/BG/wallhaven-5ge715.jpg /home/ricardo/Pictures/BG/wallhaven-5yd6d5.png &
feh --no-fehbg --bg-tile --randomize /home/ricardo/Pictures/BGWide/* &

# Screenshot tool
flameshot &

# Volume manager
volumeicon &

# Starts num lock
numlockx &

# Set the screensaver duration and DPMS
xset s 1200 1200          # screen saver timeout: 1200 seconds (20 mins)
xset dpms 0 0 1800        # DPMS off after 1800 seconds (30 mins)

# Starts the clipboard manager
diodon &

# Keyring
gnome-keyring-daemon --start --daemonize --components=secrets &
